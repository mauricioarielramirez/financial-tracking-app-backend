# Copiar este archivo a .env y ajustar valores para desarrollo local.
# .env está en .gitignore: nunca se versiona.

HTTP_PORT=8080

DB_DRIVER=sqlite3
DB_DSN=./finance.db
MIGRATIONS_PATH=./migrations

# Vacío = sin autenticación (uso local). Definir sólo si se expone el
# backend fuera de localhost (RNF-01).
API_KEY=

DOLARAPI_BASE_URL=https://dolarapi.com/v1
DOLAR_TIPO=oficial
DOLAR_CAMPO=venta

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
EXTERNAL_API_TIMEOUT_SECONDS=5

# Sólo necesario para cmd/import (RF-09), cuando se implemente.
GOOGLE_SERVICE_ACCOUNT_FILE=
